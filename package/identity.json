{
  "contractVersion": 1,
  "status": "w3_event_ingress_offline",
  "id": "redcms.store-lite-wompi",
  "name": "RED-CMS Store Lite Wompi",
  "repository": "redcms-store-lite-wompi",
  "manifest": {
    "schemaVersion": 1,
    "type": "adapter",
    "version": "0.3.0",
    "cmsCompatibility": ">=5.1 <6.0",
    "phpCompatibility": ">=8.2 <9.0",
    "requiredDependency": {
      "id": "redcms.store-lite",
      "version": ">=0.1.35 <1.0"
    },
    "adapterId": "redcms.store-lite-wompi/checkout",
    "outboundHost": "sandbox.wompi.co",
    "readOnlyOperation": "merchant.acceptance-contracts.retrieve-sandbox",
    "webCheckout": {
      "action": "https://checkout.wompi.co/p/",
      "operations": [
        "checkout.web.plan",
        "events.transaction-updated.verify",
        "events.transaction-updated.coordinate"
      ]
    }
  },
  "exclusions": [
    "installation",
    "migration-execution",
    "enablement",
    "runtime-publication",
    "route-exposure",
    "secret-resolution",
    "wire-request-return",
    "wire-request-persistence",
    "provider-sdk",
    "wompi-dashboard-access",
    "production-provider-contact",
    "wompi-transaction",
    "nequi-notification",
    "payment",
    "webhook-ingress",
    "browser-flow",
    "store-lite-mutation",
    "hosted-demo-change",
    "client-deployment"
  ]
}
